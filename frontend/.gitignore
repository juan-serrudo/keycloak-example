# ============================================================
# DEPENDENCIAS DE NODE.JS
# ============================================================

# Dependencias instaladas mediante npm.
# No deben subirse porque se reconstruyen con npm install o npm ci.
node_modules/


# ============================================================
# ARCHIVOS GENERADOS POR VITE
# ============================================================

# Resultado de la compilación de producción: npm run build
dist/

# Posible salida para aplicaciones con renderizado del lado servidor.
dist-ssr/

# Caché interna de Vite.
.vite/


# ============================================================
# TYPESCRIPT
# ============================================================

# Información incremental generada por TypeScript.
# Se vuelve a generar durante la compilación.
*.tsbuildinfo


# ============================================================
# PRUEBAS Y COBERTURA
# ============================================================

# Reportes generados por herramientas como Vitest, Jest o Istanbul.
coverage/

# Resultados temporales de pruebas.
test-results/

# Reportes de pruebas end-to-end, por ejemplo Playwright.
playwright-report/
blob-report/


# ============================================================
# VARIABLES DE ENTORNO
# ============================================================

# Variables locales o sensibles.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignora cualquier variante local adicional.
.env.*.local

# IMPORTANTE:
# No ignores .env.example, porque debe documentar las variables necesarias.
!.env.example


# ============================================================
# ARCHIVOS DE REGISTRO
# ============================================================

# Archivos generales de log.
*.log
logs/

# Logs específicos de gestores de paquetes.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Información de procesos.
*.pid
*.pid.lock


# ============================================================
# CACHÉS Y ARCHIVOS TEMPORALES
# ============================================================

# Cachés de herramientas.
.cache/
.eslintcache
.stylelintcache

# Archivos temporales.
*.tmp
*.temp

# Archivos temporales creados por algunos editores.
*.swp
*.swo
*~


# ============================================================
# VISUAL STUDIO CODE
# ============================================================

# Ignora la configuración personal de VS Code.
.vscode/*

# Permite compartir configuraciones útiles para todo el equipo.
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json


# ============================================================
# OTROS EDITORES E IDE
# ============================================================

# IntelliJ IDEA y WebStorm.
.idea/
*.iml

# Visual Studio.
.vs/


# ============================================================
# SISTEMAS OPERATIVOS
# ============================================================

# macOS.
.DS_Store
.AppleDouble
.LSOverride

# Windows.
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux y gestores de archivos.
.directory
.Trash-*


# ============================================================
# CERTIFICADOS, CLAVES Y CREDENCIALES
# ============================================================

# Claves privadas y certificados que no deberían versionarse.
*.key
*.pem
*.p12
*.pfx

# Archivos potencialmente sensibles.
credentials.json
secrets.json


# ============================================================
# CONTENEDORES Y DESPLIEGUE LOCAL
# ============================================================

# Sobrescrituras locales de Docker Compose.
docker-compose.override.yml
compose.override.yml

# Archivos locales de Kubernetes.
*.kubeconfig


# ============================================================
# ARCHIVOS COMPRIMIDOS O GENERADOS LOCALMENTE
# ============================================================

*.zip
*.tar
*.tar.gz
*.tgz
