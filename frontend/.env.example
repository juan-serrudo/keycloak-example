# ============================================================
# PLANTILLA DE CONFIGURACIÓN PÚBLICA DEL FRONTEND
# ============================================================
# Copiar como .env.local y ajustar los valores del entorno:
#   cp .env.example .env.local
#
# Vite expone al navegador toda variable con prefijo VITE_. Por ello este
# archivo sólo documenta configuración pública: nunca agregar contraseñas,
# tokens, claves privadas ni un client_secret.

# ============================================================
# VARIABLES ACTUALES
# ============================================================

# API HTTP
# Dirección base de FastAPI. Está reservada para la siguiente fase y todavía
# no es leída por el frontend.
VITE_API_URL=http://localhost:8000

# AUTENTICACIÓN OPENID CONNECT
# URL pública de Keycloak, sin /realms/<realm> al final.
VITE_KEYCLOAK_URL=http://localhost:8080

# Realm donde existen los usuarios, roles y clientes de la aplicación.
VITE_KEYCLOAK_REALM=uoit

# Cliente público configurado para Authorization Code Flow + PKCE S256.
VITE_KEYCLOAK_CLIENT_ID=sig-uoit-frontend

# ============================================================
# VARIABLES RECOMENDADAS PARA FUTURAS FASES
# ============================================================
# Están comentadas porque el código todavía no las consume. Deben activarse
# solamente al implementar y validar la funcionalidad correspondiente.

# API: tiempo máximo de espera y versión base de las rutas.
# VITE_API_TIMEOUT_MS=10000
# VITE_API_PATH_PREFIX=/api/v1

# Sesión: sustituirían los valores 60 s y 30000 ms hoy fijados en App.tsx.
# VITE_AUTH_TOKEN_MIN_VALIDITY_SECONDS=60
# VITE_AUTH_CHECK_INTERVAL_MS=30000

# Observabilidad pública. Un DSN de navegador no es una clave privada, pero
# conviene limitarlo por dominio y entorno desde el proveedor.
# VITE_LOG_LEVEL=info
# VITE_SENTRY_DSN=

# Identificación del artefacto desplegado para diagnóstico y trazabilidad.
# VITE_APP_VERSION=0.0.0
# VITE_BUILD_COMMIT=local

# Funcionalidades opcionales. Mantener el prefijo VITE_FEATURE_ permite
# reconocer los feature flags rápidamente.
# VITE_FEATURE_EXAMPLE=false

# No es necesario crear VITE_APP_ENV: Vite ya ofrece import.meta.env.MODE,
# import.meta.env.DEV y import.meta.env.PROD.
